{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "max-yoga",
  "main": "workers/cron.js",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["0 8 * * *"]
  }
}
